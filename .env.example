# Local-only concept/demo defaults. No external API keys are required for demo mode.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4200
NEXT_PUBLIC_WP_URL=http://localhost:8080
DATABASE_URL=postgresql://apex:apex-local-demo@localhost:5432/apex
PYTHON_URL=http://localhost:8001
SERVICE_TOKEN=local-demo-service-token
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
WEB_URL=http://localhost:3000
COOKIE_SECURE=false
POSTGRES_PASSWORD=apex-local-demo
WP_DB_PASSWORD=apex-wp-local-demo
WP_ROOT_PASSWORD=apex-wp-root-local-demo
WP_DEMO_PASSWORD=ApexDemo2026!
# Optional: set only Stripe TEST credentials. Live keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional persistent signing key; if omitted a cryptographically random key is generated at startup.
JWT_SECRET=
